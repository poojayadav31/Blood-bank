PORT=5050
NODE_ENV=development
JWT_SECRET=bbms_jwt_super_secret_key_2026_production_ready
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=bbms_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL Configuration
# If DATABASE_URL or DB_HOST is configured and accessible, system connects to PostgreSQL.
# Otherwise, system seamlessly uses the internal relational database engine with identical schema.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloodbank
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bloodbank

# Default Limits
DEFAULT_COLLECTION_LIMIT=300
MAX_CAMP_EXPECTED_LIMIT=300
